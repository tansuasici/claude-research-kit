[
  {
    "name": "s01-citation-gate-fails-on-dangling-cite",
    "hook": ".claude/hooks/citation-gate.sh",
    "setup_files": {
      "main.tex": "\\documentclass{article}\\begin{document}\nWe build on prior work \\cite{ghost2020}.\n\\end{document}\n",
      "references.bib": "@article{real2020,\n  author = {Smith, Jane},\n  title = {A Real Paper},\n  journal = {J. Things},\n  year = {2020}\n}\n"
    },
    "payload": { "tool_name": "Edit", "tool_input": { "file_path": "{TMPROOT}/main.tex" } },
    "expect": {
      "exit_code": 0,
      "state": [ { "file": ".hook-state/last_quality_gate.json", "field": "status", "equals": "failed" } ]
    },
    "notes": "A \\cite key with no .bib entry is the #1 research failure mode — must record a failed verdict."
  },
